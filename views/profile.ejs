<body>
  <div class="main-container">
    <h1>Profile</h1>
    <!-- Profile Container -->
    <div class="profile-container p-1">
      <div class="left-container">
        <div class="profile-image">
          <button type="button" class="profile-image-btn">
            <% if(profilePicture){ %>
            <img src="<%= profilePicture %>" alt="profile-pic" class="dis-img" id="profile-pic" />
            <% } else { %>
            <img src="/assets/NoProfileImage.jpg" alt="profile-pic" class="dis-img" id="profile-pic" />
            <% } %>
          </button>
        </div>
      </div>

      <div class="right-container">
        <div class="right-head">
          <p>
            <%= username %>
          </p>
          <a href="/editprofile">
            <button type="button">Edit Profile</button>
          </a>
        </div>

        <div class="right-content">
          <div>
            <h2>Bio</h2>
            <p class="bio-text"><%= biotext || "" %></p>            <span class="more-text">Show more</span>
          </div>

          <div>
            <h2>Gender</h2>
            <p class="gender-text">
              <%= gender %>
            </p>
          </div>
        </div>
      </div>
    </div>

    <!-- Post Container -->
    <div class="post-container p-1">
      <% if (posts && posts.length> 0) { %> <% posts.forEach((post)=> { %>
      <% if (post.postData.type === "image") { %>

      <!-- Image Post Card -->
      <div class="card col-lg-4 mb-3">
        <div class="card-body p-0">
          <div class="card-head">
            <div class="left-align">
              <div class="profilepic-container">
                <img class="profilepic-picture" src="<%= profilePicture %>" alt="profile-pic" />
              </div>
              <p class="username m-1">
                <%= post.userId.username %>
              </p>
            </div>

            <div class="dropdown low-z-dropdown">
              <button type="button" class="dropdown-toggle" data-bs-toggle="dropdown">
                <span>...</span>
              </button>
              <div class="dropdown-menu">
                <button type="button" class="select-file-btn">Update</button>
                <button type="button" class="delete" data-post-id="<%= post._id %>">Delete</button>
              </div>
            </div>
            <form class="updatePost-form" action="/updatePost/<%= post._id %>" method="POST" enctype="multipart/form-data">
              <input type="hidden" name="returnTo" value="/posts" />
              <input type="file" required class="post-update-input" name="post" style="display: none" accept="image/*,video/*" />
              <div class="preview-container"></div>
              <button type="button" class="close-preview">X</button>
              <textarea maxlength="300" class="caption-input" name="caption" placeholder="Edit caption..."><%= post.postData.caption %></textarea>
              <button type="submit" class="submit-update-btn">Save Updates</button>
            </form>
          </div>

          <img class="card-img" src="<%= post.postData.path %>" alt="Post Image" />

          <div class="card-heart">
            <i class="fa-solid fa-heart lg"></i>
          </div>

          <div class="card-btn">
            <button type="button" class="like" data-post-id="<%= post._id %>">
              <% if (userLikes.includes(post._id.toString())) { %>
              <i class="fa-solid fa-heart lg liked"></i>
              <% } else { %>
              <i class="fa-regular fa-heart lg"></i>
              <% } %>
            </button>
            <button type="button" class="comment" data-post-id="<%= post._id %>">
              <i class="fa-regular fa-comments lg" style="color: #ffffff"></i>
            </button>
          </div>

          <button class="like-count-btn">
            <p class="like-count" id="like-count-<%= post._id %>">
              <%= post.likeCount %>
            </p>
            <span>likes</span>
          </button>

          <p class="caption-text">
            <b>
              <%= post.userId.username %> &nbsp;
            </b><%= post.postData.caption %>
          </p>
        </div>
      </div>

      <!-- Comment Section for Image Post -->
      <div class="comment-bg-bg" data-post-id="<%= post._id %>">
        <div class="comment-bg col-lg-6 col-sm-10 col-11">
          <button type="button" class="close-comment">X</button>
          <div class="comment-container">
            <p class="caption-text"><b>
                <%= post.userId.username %> &nbsp;
              </b> <%= post.postData.caption %>
            </p>
            <p class="no-comments-msg">Be The First One To Comment.</p>
            <% if (post.comments && post.comments.length> 0) { %>
            <% post.comments.forEach((comment)=> { %>
            <div class="comments" id="comment-<%= comment._id %>">
              <p>
                <b>
                  <%= comment.userId.username %>
                </b>
                <span id="comment-text-<%= comment._id %>">
                  <%= comment.text %>
                </span>
              </p>
              <div class="dropdown">
                <button type="button" class="dropdown-toggle" data-bs-toggle="dropdown">
                  <span>...</span>
                </button>
                <div class="dropdown-menu">
                  <button type="button" class="comment-update-btn" data-comment-id="<%= comment._id %>">
                    Update
                  </button>
                  <button type="button" class="comment-delete-btn" data-comment-id="<%= comment._id %>">
                    Delete
                  </button>
                </div>
              </div>
              <div class="comment-form-bg">
                <form class="update-comment-form" id="updateComment-form-<%= comment._id %>">
                  <input type="text" maxlength="500" name="text" class="update-input" placeholder="Edit your comment..." required />
                  <button type="submit" class="real-comment-update-btn">
                    Update
                  </button>
                </form>
              </div>
            </div>
            <% })} %>

            <form data-post-id="<%= post._id %>" id="comment-form-<%= post._id %>" class="comment-form">
              <input type="text" maxlength="500" name="text" placeholder="Add a comment..." required />
              <button type="submit" class="comment-post-btn">Post</button>
            </form>
          </div>
        </div>
      </div>

      <% } else if (post.postData.type === "video") { %>

      <!-- Video Post Card -->
      <div class="card col-lg-4 mb-3">
        <div class="card-body p-0">
          <div class="card-head">
            <div class="left-align">
              <div class="profilepic-container">
                <img class="profilepic-picture" src="<%= profilePicture %>" alt="profile-pic" />
              </div>
              <p class="username m-1">
                <%= post.userId.username %>
              </p>
            </div>

            <div class="dropdown low-z-dropdown">
              <button type="button" class="dropdown-toggle" data-bs-toggle="dropdown">
                <span>...</span>
              </button>
              <div class="dropdown-menu">
                <button type="button" class="select-file-btn">Update</button>
                <button type="button" class="delete" data-post-id="<%= post._id %>">Delete</button>
              </div>
            </div>
            <form class="updatePost-form" action="/updatePost/<%= post._id %>" method="POST" enctype="multipart/form-data">
              <input type="hidden" name="returnTo" value="/posts" />
              <input type="file" required class="post-update-input" name="post" style="display: none" accept="image/*,video/*" />
              <div class="preview-container"></div>
              <button type="button" class="close-preview">X</button>
              <textarea maxlength="300" class="caption-input" name="caption" placeholder="Edit caption..."><%= post.postData.caption %></textarea>
              <button type="submit" class="submit-update-btn">Save Updates</button>
            </form>
          </div>

          <video class="card-video" controls>
            <source src="<%= post.postData.path %>" type="<%= post.postData.type %>" />
            Your Browser Does Not Support The Video Tag.
          </video>

          <div class="card-heart">
            <i class="fa-solid fa-heart lg"></i>
          </div>

          <div class="card-btn">
            <button type="button" class="like" data-post-id="<%= post._id %>">
              <% if (userLikes.includes(post._id.toString())) { %>
              <i class="fa-solid fa-heart lg liked"></i>
              <% } else { %>
              <i class="fa-regular fa-heart lg"></i>
              <% } %>
            </button>
            <button type="button" class="comment" data-post-id="<%= post._id %>">
              <i class="fa-regular fa-comments lg" style="color: #ffffff"></i>
            </button>
          </div>

          <button class="like-count-btn">
            <p class="like-count" id="like-count-<%= post._id %>">
              <%= post.likeCount %>
            </p>
            <span>likes</span>
          </button>

          <p class="caption-text"><b>
              <%= post.userId.username %> &nbsp;
            </b><%= post.postData.caption %></p>
        </div>
      </div>

      <!-- Comment Section for Video Post -->
      <div class="comment-bg-bg" data-post-id="<%= post._id %>">
        <div class="comment-bg col-lg-6 col-sm-10 col-11">
          <button type="button" class="close-comment">X</button>
          <div class="comment-container">
            <p class="caption-text"><b>
                <%= post.userId.username %> &nbsp;
              </b><%= post.postData.caption %></p>
            <p class="no-comments-msg">Be The First One To Comment.</p>
            <% if (post.comments && post.comments.length> 0) { %>
            <% post.comments.forEach((comment)=> { %>
            <div class="comments" id="comment-<%= comment._id %>">
              <p>
                <b>
                  <%= comment.userId.username %>
                </b>
                <span id="comment-text-<%= comment._id %>">
                  <%= comment.text %>
                </span>
              </p>
              <div class="dropdown">
                <button type="button" class="dropdown-toggle" data-bs-toggle="dropdown">
                  <span>...</span>
                </button>
                <div class="dropdown-menu">
                  <button type="button" class="comment-update-btn" data-comment-id="<%= comment._id %>">
                    Update
                  </button>
                  <button type="button" class="comment-delete-btn" data-comment-id="<%= comment._id %>">
                    Delete
                  </button>
                </div>
              </div>
              <div class="comment-form-bg">
                <form class="update-comment-form" id="updateComment-form-<%= comment._id %>">
                  <input type="text" maxlength="500" name="text" class="update-input" placeholder="Edit your comment..." required />
                  <button type="submit" class="real-comment-update-btn">
                    Update
                  </button>
                </form>
              </div>
            </div>
            <% })} %>

            <form data-post-id="<%= post._id %>" id="comment-form-<%= post._id %>" class="comment-form">
              <input type="text" maxlength="500" name="text" placeholder="Add a comment..." required />
              <button type="submit" class="comment-post-btn">Post</button>
            </form>
          </div>
        </div>
      </div>

      <% } else { %>
      <div class="err-text">
        <p>Unsupported File Type</p>
      </div>
      <% } %>
      <% }) %>
      <% } else { %>
      <div class="err-text">
        <p>You Have Not Posted Anything Yet.</p>
      </div>
      <% } %>
    </div>
  </div>

  <!-- Edit Profile Image Modal -->
  <div class="edit-bg"></div>
  <div class="edit-pic">
    <h2>Change Profile Image</h2>
    <form id="uploadForm" action="/uploads" method="POST" enctype="multipart/form-data">
      <button class="upload-btn" type="button">Upload Photo</button>
      <input type="hidden" name="returnTo" value="/profile" />
      <input type="file" required id="fileInput" name="profilePicture" style="display: none" accept="image/*" />
    </form>
    <button class="remove-btn" type="button">Remove Current Photo</button>
    <button class="cancel-btn" type="button">Cancel</button>
  </div>
</body>